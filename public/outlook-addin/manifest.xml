<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
  xsi:type="MailApp">

  <Id>3f6e2b8a-9c4d-4f1a-8e7b-2d5c6a9f0b1e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>MailTracking</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="MailTracking" />
  <Description DefaultValue="Adds an open-tracking pixel to outgoing mail and reports to your MailTracking dashboard. Never blocks or delays sending." />
  <IconUrl DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/oded-ben/MailTracking" />

  <AppDomains>
    <AppDomain>https://mail-tracking-chi.vercel.app</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/commands.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <!-- 1.12 is the minimum where OnMessageSend exists at all, but
           Microsoft's own current sample requests 1.15 "to support Smart
           Alerts enhancements introduced in later requirement sets" -
           matching that exactly, since the handler-never-invoked symptom
           we're chasing could be exactly this kind of enhancement gap. -->
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Event-based activation runs in a lightweight runtime, no visible UI. -->
          <Runtimes>
            <!-- HTML file used by Outlook on the web, on Mac, and new Outlook on Windows. -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- Plain JS file used by classic Outlook on Windows. -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/commands.html" />
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/commands.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://mail-tracking-chi.vercel.app/outlook-addin/commands.js" />
        </bt:Urls>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
