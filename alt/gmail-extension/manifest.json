{
  "manifest_version": 3,
  "name": "MailTracking for Gmail",
  "version": "1.0.0",
  "description": "Adds an open-tracking pixel to emails sent from Gmail's web UI and reports opens to your self-hosted MailTracking dashboard.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTracking for Gmail"
  }
}
